{
  "name": "flow-download-manager",
  "version": "2.7.1",
  "description": "Local-first download manager with Realm and an Electron shell",
  "main": "src/electron.cjs",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "web": "node src/server.cjs",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable nsis",
    "postinstall": "node scripts/setup.cjs",
    "native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dist:linux": "electron-builder --linux AppImage deb rpm --x64",
    "prepare:linux": "node scripts/prepare-linux.cjs"
  },
  "dependencies": {
    "basic-ftp": "6.2.3",
    "cheerio": "1.2.0",
    "ffmpeg-static": "5.3.0",
    "http2-wrapper": "2.2.1",
    "proxy-agent": "6.5.0",
    "realm": "20.2.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "basic-ftp": "$basic-ftp"
  },
  "build": {
    "npmRebuild": false,
    "appId": "local.flow.downloads",
    "productName": "Flow",
    "asarUnpack": [
      "node_modules/realm/**",
      "node_modules/ffmpeg-static/**",
      "native/**",
      "vendor/**",
      "ui/sounds/**",
      "vendor/aria2/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "ui/**",
      "extension/**",
      "package.json",
      "README.md",
      "FEATURES.md",
      "THIRD-PARTY-NOTICES.md",
      "native/FlowNativeHost.exe",
      "vendor/**",
      "BROWSER-INTEGRATION.md",
      "RESEARCH-AND-UPGRADES.md",
      "competitor-profiles/*.md",
      "REVIEW-AND-TOOLS.md",
      "docs/**",
      "COPYRIGHT.md",
      "CHANGELOG.md",
      "VALIDATION.md",
      "LICENSE",
      "native/flow-native-host.cjs"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Flow-${version}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Flow-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "icon": "ui/logo.png",
      "executableName": "flow",
      "artifactName": "Flow-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Flow Download Manager",
          "Comment": "A simple, local-first download manager",
          "Keywords": "download;manager;video;queue;",
          "StartupWMClass": "flow-download-manager"
        }
      },
      "maintainer": "mohamed abdelnaby <82710469+Mohamedabdelnaby1@users.noreply.github.com>"
    },
    "deb": {
      "artifactName": "Flow-${version}-linux-amd64.deb",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "pulseaudio-utils",
        "aria2"
      ]
    },
    "rpm": {
      "artifactName": "Flow-${version}-linux-x86_64.rpm",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "pulseaudio-utils",
        "aria2"
      ]
    },
    "afterPack": "./scripts/prepare-windows-build.cjs"
  },
  "author": {
    "name": "mohamed abdelnaby",
    "url": "https://www.facebook.com/mohamedabdelnaby190",
    "email": "82710469+Mohamedabdelnaby1@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Mohamedabdelnaby1/flow-download-manager"
}
