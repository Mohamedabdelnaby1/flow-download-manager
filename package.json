{
  "name": "flow-download-manager",
  "version": "2.5.2",
  "description": "Local-first download manager with Realm and an Electron shell",
  "main": "src/electron.cjs",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "web": "node src/server.cjs",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable nsis",
    "postinstall": "node scripts/setup.cjs",
    "native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1"
  },
  "dependencies": {
    "basic-ftp": "6.2.3",
    "cheerio": "1.2.0",
    "ffmpeg-static": "5.3.0",
    "http2-wrapper": "2.2.1",
    "proxy-agent": "6.5.0",
    "realm": "20.2.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "basic-ftp": "$basic-ftp"
  },
  "build": {
    "npmRebuild": false,
    "appId": "local.flow.downloads",
    "productName": "Flow",
    "asarUnpack": [
      "node_modules/realm/**",
      "node_modules/ffmpeg-static/**",
      "native/**",
      "vendor/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "ui/**",
      "extension/**",
      "package.json",
      "README.md",
      "FEATURES.md",
      "THIRD-PARTY-NOTICES.md",
      "native/FlowNativeHost.exe",
      "vendor/**",
      "BROWSER-INTEGRATION.md",
      "RESEARCH-AND-UPGRADES.md",
      "competitor-profiles/*.md",
      "REVIEW-AND-TOOLS.md",
      "docs/**",
      "COPYRIGHT.md",
      "CHANGELOG.md",
      "VALIDATION.md",
      "LICENSE"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Flow-${version}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Flow-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  },
  "author": {
    "name": "mohamed abdelnaby",
    "url": "https://www.facebook.com/mohamedabdelnaby190"
  },
  "license": "MIT"
}
