{
  "manifest_version": 3,
  "name": "Flow Companion",
  "version": "2.7.0",
  "description": "Desktop downloads, context menus, media detection and authorized session handoff.",
  "permissions": [
    "contextMenus",
    "storage",
    "webRequest",
    "tabs",
    "downloads",
    "cookies",
    "nativeMessaging",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow downloads"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "panel-model.js",
        "media-model.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "key": ""
}
